# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Auto-generated video files
/public/outputs/
/public/tts/
*.mp4

# 生成画像用の派生ファイル（scripts/build-character-assets.mjs がビルドの直前に作る）
/assets/characters/trimmed/

# 取得した元フォントの置き場（scripts/build-font-subset.mjs）
/.cache/

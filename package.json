{
  "name": "web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-content.mjs && node scripts/check-banned-terms.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check": "tsc --noEmit && node scripts/check-content.mjs && node scripts/check-banned-terms.mjs && npm test",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"lib/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "check:redirects": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-redirects.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.102.1",
    "@types/recharts": "^1.8.29",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "openai": "^6.34.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
